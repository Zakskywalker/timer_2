<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Company>Time Recorder Project</Company>
    <Product>Time Recorder 2.0 Setup</Product>
    <Authors>Time Recorder Project</Authors>
    <Description>Time Recorder 2.0 Windows 11 Setup Wizard</Description>
    <Copyright>Copyright © 2026. Licensed under GNU GPLv3</Copyright>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="LICENSE" Condition="Exists('..\..\LICENSE')" />
  </ItemGroup>

  <PropertyGroup>
    <InstallerPayloadPath Condition="'$(InstallerPayloadPath)' == ''">$(MSBuildProjectDirectory)\obj\$(Configuration)\installer-payload\Timer2.App.exe</InstallerPayloadPath>
    <InstallerPayloadDirectory>$([System.IO.Path]::GetDirectoryName('$(InstallerPayloadPath)'))\</InstallerPayloadDirectory>
  </PropertyGroup>

  <ItemGroup Condition="'$(DesignTimeBuild)' != 'true'">
    <EmbeddedResource Include="$(InstallerPayloadPath)" LogicalName="Timer2.App.exe" />
  </ItemGroup>

  <Target Name="PublishTimer2ApplicationPayload" BeforeTargets="PrepareResources" Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild
      Projects="$(MSBuildProjectDirectory)\..\Timer2.App\Timer2.App.csproj"
      Targets="Restore;Publish"
      Properties="Configuration=Release;RuntimeIdentifier=win-x64;SelfContained=true;PublishSingleFile=true;IncludeNativeLibrariesForSelfExtract=true;PublishDir=$(InstallerPayloadDirectory)"
      Condition="!Exists('$(InstallerPayloadPath)')" />
    <Error Condition="!Exists('$(InstallerPayloadPath)')" Text="The Time Recorder application payload was not published to $(InstallerPayloadPath)." />
  </Target>

</Project>
